NODE_ENV=development
PORT=5000

# Application branding
COMPANY_NAME=Yatrilog.com
COMPANY_EMAIL=your-company-email@example.com
SUPPORT_EMAIL=your-support-email@example.com

# Database / authentication
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret

# Payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
PAYMENT_WAITING_TIME_MINUTES=10
CANCELLATION_CUTOFF_MINUTES=60

# Frontend URL
CLIENT_URL=http://localhost:5173

# Email verification / password reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-company-email@example.com
SMTP_PASS=your_gmail_app_password
# Optional: if omitted, the sender is built from COMPANY_NAME + COMPANY_EMAIL.
# SMTP_FROM=Yatrilog.com <your-company-email@example.com>
